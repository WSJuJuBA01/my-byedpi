<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WSByeDPI"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Предупреждение про все приложения -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardWarningAllApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#2A2100"
            app:strokeColor="#FFC107"
            app:strokeWidth="1dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="⚠️️ Внимание: Трафик пущен через ВСЕ приложения. Для максимальной скорости и стабильности выберите конкретные программы в настройках."
                android:textColor="#FFD54F"
                android:textSize="13sp" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Режим обхода (ByeByeDPI):"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />

        <!-- Кнопки выбора режима -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleGroupModes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/btnMode1"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Обычный" />

            <Button
                android:id="@+id/btnMode2"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Disorder" />

            <Button
                android:id="@+id/btnMode3"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Медиа" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:id="@+id/tvModeDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#888888"
            android:textSize="12sp" />

        <!-- Выбор приложений -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelectApps"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Выбрать приложения (Per-App VPN)" />

        <!-- Кнопка Вкл/Выкл -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleVpn"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:text="ЗАПУСТИТЬ VPN"
            android:textSize="16sp"
            app:cornerRadius="12dp" />

    </LinearLayout>
</ScrollView>
